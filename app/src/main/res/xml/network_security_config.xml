<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Runtime URL policy keeps cleartext disabled until an administrator opts in. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
