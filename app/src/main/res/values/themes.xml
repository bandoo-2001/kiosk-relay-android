<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KioskRelay" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/kiosk_navy</item>
        <item name="android:statusBarColor">@color/kiosk_navy</item>
        <item name="android:navigationBarColor">@color/kiosk_navy</item>
        <item name="android:colorAccent">@color/kiosk_cyan</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.KioskRelay.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kiosk_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.KioskRelay</item>
    </style>
</resources>
